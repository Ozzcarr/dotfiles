* {
active: #a6e3a1;
bg: #1e1e2e;
bg-alt: #fab387;
border-color: #f2cdcd;
foreground: #181825;
selected: #f38ba8;
text-color: #cdd6f4;
text-selected: #1e1e2e;
urgent: #cba6f7;
}

button {
background-color: @bg-alt;
border-radius: 10px;
cursor: pointer;
padding: 15px;
text-color: inherit;
}

button selected {
background-color: @selected;
text-color: @foreground;
}

dummy {
background-color: transparent;
}

element {
background-color: transparent;
border-radius: 10px;
cursor: pointer;
enabled: true;
padding: 8px;
spacing: 15px;
text-color: @text-color;
}

element normal.active {
background-color: inherit;
text-color: @text-color;
}

element normal.normal {
background-color: inherit;
text-color: @text-color;
}

element normal.urgent {
background-color: @urgent;
text-color: @text-color;
}

element selected.active {
background-color: @urgent;
text-color: @text-selected;
}

element selected.normal {
background-color: @selected;
text-color: @foreground;
}

element selected.urgent {
background-color: @urgent;
text-color: @text-selected;
}

element-icon {
background-color: transparent;
cursor: inherit;
size: 36px;
text-color: inherit;
}

element-text {
background-color: transparent;
cursor: inherit;
horizontal-align: 0.0;
text-color: inherit;
vertical-align: 0.5;
}

entry {
background-color: inherit;
cursor: text;
enabled: true;
placeholder: "Search";
placeholder-color: inherit;
text-color: inherit;
}

error-message {
background-color: @bg;
border-radius: 20px;
padding: 15px;
text-color: @foreground;
}

imagebox {
background-color: transparent;
background-image: url("~/Pictures/Wallpapers/cat-waves.png", height);
children: [ inputbar,dummy,mode-switcher ];
orientation: vertical;
padding: 20px;
}

inputbar {
background-color: @bg-alt;
border-radius: 10px;
children: [ textbox-prompt-colon,entry ];
enabled: true;
padding: 10px;
spacing: 10px;
text-color: @foreground;
}

listbox {
background-color: transparent;
children: [ message,listview ];
orientation: vertical;
padding: 20px;
spacing: 20px;
}

listview {
background-color: transparent;
columns: 1;
cursor: "default";
cycle: true;
dynamic: true;
enabled: true;
fixed-columns: true;
fixed-height: true;
layout: vertical;
lines: 8;
reverse: false;
scrollbar: false;
spacing: 10px;
text-color: @foreground;
}

mainbox {
background-color: transparent;
children: [ imagebox,listbox ];
enabled: true;
orientation: horizontal;
spacing: 0px;
}

message {
background-color: transparent;
}

mode-switcher {
background-color: transparent;
enabled: true;
spacing: 20px;
text-color: @foreground;
}

textbox {
background-color: @bg-alt;
border-radius: 10px;
horizontal-align: 0.0;
padding: 15px;
text-color: @foreground;
vertical-align: 0.5;
}

textbox-prompt-colon {
background-color: inherit;
enabled: true;
expand: false;
str: "";
text-color: inherit;
}

window {
anchor: center;
background-color: @bg;
border-radius: 15px;
cursor: "default";
enabled: true;
fullscreen: false;
location: center;
transparency: "real";
width: 1000px;
x-offset: 0px;
y-offset: 0px;
}
