configuration {
    modi: "drun,calc";
    show-icons: true;
    display-drun: "Apps";
    display-calc: "Calculator";
    drun-display-format: "{name}";
    kb-mode-next: "Tab";
    kb-mode-previous: "Shift+Tab";
    kb-element-next: "";
    kb-element-previous: "";
}

* {
    base:     #1e1e2eff;
    mantle:   #181825ff;
    surface0: #313244ff;
    text:     #cdd6f4ff;
    subtext0: #a6adc8ff;
    mauve:    #cba6f7ff;
}

window {
    width: 30%;
    background-color: @base;
    border: 2px;
    border-color: @mauve;
    border-radius: 10px;
    padding: 12px;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, mode-switcher, message, listview ];
    spacing: 12px;
}

mode-switcher {
    spacing: 4px;
}

button {
    background-color: @mantle;
    text-color: @subtext0;
    border-radius: 6px;
    padding: 4px 0px;
    horizontal-align: 0.5;
}

button selected {
    background-color: @surface0;
    text-color: @mauve;
}

message {
    background-color: @mantle;
    border-radius: 6px;
    padding: 8px 12px;
}

textbox {
    text-color: @mauve;
}

inputbar {
    background-color: @mantle;
    text-color: @text;
    border-radius: 6px;
    padding: 8px 12px;
    children: [ entry ];
}

entry {
    background-color: transparent;
    text-color: @text;
    placeholder: "Search...";
    placeholder-color: @subtext0;
}

listview {
    background-color: transparent;
    lines: 8;
    fixed-height: true;
    spacing: 4px;
    scrollbar: false;
}

element {
    padding: 6px 8px;
    border-radius: 6px;
}

element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color: @text;
}

element selected.normal {
    background-color: @surface0;
    text-color: @mauve;
}

element-icon {
    size: 24px;
    background-color: transparent;
    text-color: inherit;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}
